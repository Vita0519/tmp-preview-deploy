#!/bin/bash
# 安装前：准备数据目录，并检查镜像是否已构建。任何异常都不阻断安装。
LOG=/tmp/tmp-preview-install.log
{
    echo "=== install_init $(date) ==="
    echo "TRIM_PKGVAR=${TRIM_PKGVAR}"
    echo "TRIM_APPDEST=${TRIM_APPDEST}"
    echo "whoami=$(id -un 2>/dev/null)"
} >> "$LOG" 2>/dev/null

if [ -n "${TRIM_PKGVAR}" ]; then
    mkdir -p "${TRIM_PKGVAR}/data/projects" "${TRIM_PKGVAR}/data/zips" >> "$LOG" 2>&1
fi

if command -v docker >/dev/null 2>&1; then
    IMG="ghcr.io/vita0519/tmp-preview:2.0.0"
    if docker image inspect "$IMG" >/dev/null 2>&1; then
        echo "[ok] 镜像 $IMG 已在本地" >> "$LOG" 2>/dev/null
    else
        echo "[i] 本地无 $IMG，启动时将从 ghcr 拉取；若拉取失败请用 app.tgz 内 docker/build_image.sh 构建" >> "$LOG" 2>/dev/null
    fi
fi

exit 0
