#!/bin/bash
# 生命周期入口：start/stop 由应用中心执行 compose，这里只做状态查询

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
CONTAINER="tmp-preview-fnos"

is_running() {
    if ! command -v docker >/dev/null 2>&1; then
        return 1
    fi
    docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true
}

case "$1" in
start)
    # 容器由应用中心按 docker-compose.yaml 启动
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
