# 复制为 .env 后按需修改：cp .env.example .env
# 对外端口
PORT=8080

# 站点信息
SITE_TITLE=临时预览站
SITE_SUBTITLE=到期自动回收 · 多 Agent 共享

# 初始管理员（首次启动时创建；已有账号则忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=管理员

# 默认存活时长（小时），0 = 永久
DEFAULT_TTL_HOURS=24

# 单项目体积上限（MB）
MAX_UPLOAD_MB=1024

# 允许匿名访问 /portal 列表（0/1）
PUBLIC_PORTAL=0

# 部署在 HTTPS 之后时设为 1，Cookie 带 Secure
COOKIE_SECURE=0

# 登录态有效天数
SESSION_DAYS=7

TZ=Asia/Shanghai
