# 复制为 .env 后按需修改：cp .env.example .env
# 对外端口
PORT=8080

# 镜像版本：默认钉到具体版本，保证可复现、可回滚
# 想一直跟最新可改成 latest，但升级前必须 docker compose pull
IMAGE_TAG=2.9.2

# 站点信息
SITE_TITLE=临时预览站
SITE_SUBTITLE=到期自动回收 · 多 Agent 共享

# 门户顶部「作者名片」的初始值（之后在「设置」页改）
# 这两项是出厂默认值，请勿写入真实姓名、手机号、邮箱等个人信息
AUTHOR_NAME=vita
AUTHOR_BIO=互联网混子

# 初始管理员（首次启动时创建；已有账号则忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=管理员

# 默认存活时长（小时），按项目可见性区分；0 = 永久
# 这三项是初始默认值，之后在「设置」页改的值优先
DEFAULT_TTL_PORTAL_HOURS=6
DEFAULT_TTL_LINK_HOURS=12
DEFAULT_TTL_PRIVATE_HOURS=0

# 未单独配置时的兜底时长（小时）
DEFAULT_TTL_HOURS=24

# 单项目体积上限（MB）
MAX_UPLOAD_MB=1024

# 允许匿名访问门户首页（/）（0/1）
PUBLIC_PORTAL=0

# 部署在 HTTPS 之后时设为 1，Cookie 带 Secure
COOKIE_SECURE=0

# 登录态有效天数
SESSION_DAYS=7

TZ=Asia/Shanghai

# Agent 接入指南地址（默认指向项目方托管的指南页；fork 后可换成自己的）
# SKILL_GUIDE_URL=https://pre.allfather.top/v/agent-guide

# 主题商店镜像（可选）：raw.githubusercontent 不通时，填自建镜像前缀
# THEME_RAW_MIRROR=

# 主题商店的 GitHub API Token（可选）：提高 API 限额（未认证 60 次/小时 → 5000）
# THEME_GH_TOKEN=

# 根路径打开什么：portal=访客门户（默认，后台在 /admin/）；admin=直接进后台，门户留在 /portal
ROOT_PAGE=portal
